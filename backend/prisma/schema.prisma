// Schema Prisma — Ibag Couture
//
// Traduction des 5 modeles Mongoose vers PostgreSQL.
//
// Principe directeur : les structures imbriquees (options, mesures, snapshot
// produit, infos client d'une commande) restent en colonnes `Json` plutot que
// d'etre eclatees en tables. Les reponses de l'API gardent ainsi exactement la
// meme forme qu'aujourd'hui, et le frontend Next.js n'a pas a etre touche.
//
// Le relationnel est reserve aux vraies relations :
//   Product <- Order -> Client/User,  Order <- Payment
//
// Note sur l'identifiant : Prisma expose `id`, alors que le frontend lit `_id`
// (83 occurrences dans 20 fichiers). Un serialiseur unique cote API renverra
// `_id` en sortie — un seul helper, pas 20 fichiers a modifier.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enumerations
// ---------------------------------------------------------------------------

enum Role {
  client
  admin
}

enum Category {
  homme
  femme
  traditionnel
  moderne
}

// Tailles du pret-a-porter. La taille d'une commande n'utilise pas cette
// enumeration : elle accepte aussi "sur-mesure", dont le tiret est interdit
// dans un identifiant Prisma. Order.size reste donc une chaine, validee par
// express-validator comme aujourd'hui.
enum Size {
  S
  M
  L
  XL
  XXL
}

enum OrderStatus {
  pending
  in_production
  ready
  delivered
  cancelled
}

// Les valeurs anglaises historiques (unpaid/paid/refunded) sont volontairement
// abandonnees : la base repart vide, c'est l'occasion de ne garder qu'un seul
// jeu de valeurs. Voir scripts/migratePaymentStatus.js pour l'historique.
enum PaymentStatus {
  non_paye
  acompte
  paye
  rembourse
}

enum WorkshopStatus {
  en_attente
  en_cours
  retouche
  pret
  livre
}

enum PaymentMethod {
  especes
  wave
  orange_money
  autre
}

enum ClientType {
  sur_place
  en_ligne
}

// ---------------------------------------------------------------------------
// Modeles
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(255)
  password  String // jamais serialise vers l'API
  role      Role     @default(client)
  fullName  String?  @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([role, isActive])
  @@map("users")
}

model Product {
  id   String @id @default(cuid())
  name String @db.VarChar(200)
  slug String @unique

  category  Category
  basePrice Decimal  @db.Decimal(12, 2)

  // promoPrice null = pas de promotion en cours
  promoPrice Decimal? @db.Decimal(12, 2)

  mainImage String?
  images    String[] @default([])

  availableSizes    Size[]  @default([])
  isCustomAvailable Boolean @default(false)
  customPriceImpact Decimal @default(0) @db.Decimal(12, 2)

  // [{ name: string, price: number }]
  options Json @default("[]")

  description    String? @db.VarChar(2000)
  productionTime Int     @default(7)

  hasStock      Boolean @default(false)
  stockQuantity Int?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([category, isActive])
  @@index([isActive, createdAt])
  @@index([name])
  @@map("products")
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  // Le produit peut etre supprime : la commande survit grace au snapshot.
  // SetNull reproduit exactement le comportement actuel (reference orpheline
  // + repli sur productSnapshot cote lecture).
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?

  // { name, slug, category, mainImage, basePrice }
  productSnapshot Json?

  // [{ name: string, price: number }]
  selectedOptions Json @default("[]")

  // Tailles du pret-a-porter ou "sur-mesure" — voir le commentaire de l'enum Size
  size String @db.VarChar(20)

  // { shoulders, chest, waist, hips, garmentLength, notes }
  // Requis uniquement quand size = "sur-mesure" (validation applicative)
  measurements Json?

  // { fullName, phone, email }
  customer Json

  basePrice    Decimal @db.Decimal(12, 2)
  optionsPrice Decimal @default(0) @db.Decimal(12, 2)

  // Supplement facture pour une confection sur-mesure. Trace a part pour que
  // le total reste decomposable : base + options + supplement.
  customSurcharge Decimal @default(0) @db.Decimal(12, 2)

  totalPrice Decimal @db.Decimal(12, 2)

  status        OrderStatus   @default(pending)
  paymentStatus PaymentStatus @default(non_paye)

  // Commande passee en etant connecte (optionnel : commande invite possible)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  // Fiche client de l'atelier (distincte du compte utilisateur)
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?

  assignedTailor       String?        @db.VarChar(100)
  productionStartDate  DateTime?
  expectedDeliveryDate DateTime?
  workshopStatus       WorkshopStatus @default(en_attente)

  notes      String? @db.VarChar(1000)
  adminNotes String? @db.VarChar(2000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([userId])
  @@index([clientId])
  @@index([productId])
  @@index([workshopStatus])
  @@index([expectedDeliveryDate])
  @@map("orders")
}

model Payment {
  id String @id @default(cuid())

  // Supprimer une commande supprime ses paiements : ils n'ont pas de sens seuls.
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?

  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  paymentDate   DateTime      @default(now())
  notes         String?       @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, createdAt])
  @@index([clientId])
  @@index([paymentMethod])
  @@index([paymentDate])
  @@map("payments")
}

model Client {
  id         String     @id @default(cuid())
  fullName   String     @db.VarChar(100)
  phone      String
  email      String?
  clientType ClientType @default(sur_place)

  address String? @db.VarChar(500)
  notes   String? @db.VarChar(1000)

  // { shoulders, chest, waist, hips, boubouLength, pantsLength, sleeveLength,
  //   customMeasurements: [{ label, value }], notes }
  measurements Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders   Order[]
  payments Payment[]

  @@index([phone])
  @@index([clientType])
  @@index([createdAt])
  @@index([fullName])
  @@map("clients")
}
